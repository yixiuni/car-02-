         if (!c->line_missing) { c->line_missing=true; c->missing_at=in->now_ms; }
     }
 }
+static void ObserveArcLine(CarControl *c,bool fresh)
+{
+    if (!CAR_TIME_TRIAL_ARC_OBSERVER || !FastCourse(c) || c->state!=CAR_ARC || !fresh ||
+        c->line_missing || !c->have_line || c->black_frames<CAR_LINE_CONFIRM_FRAMES ||
+        fabsf(c->line_error)>1.5f*CAR_GRAY_PITCH_MM ||
+        c->distance_mm-c->segment_distance<c->geometry.sensor_forward_mm) return;
+    /* A fresh black point lies on the known circle. Its radial residual is a
+     * one-dimensional position observation, not an endpoint or yaw observation.
+     * Limit each correction and reject a distant/wrong-half-circle hypothesis. */
+    float cx=c->segment==1 ? 1000.0f : 0.0f;
+    float cs=cosf(c->heading_rad),sn=sinf(c->heading_rad);
+    float px=c->x_mm+c->geometry.sensor_forward_mm*cs+c->line_error*sn;
+    float py=c->y_mm+c->geometry.sensor_forward_mm*sn-c->line_error*cs;
+    float dx=px-cx,dy=py+400.0f;
+    if ((c->segment==1 && dx < -30) || (c->segment==3 && dx > 30)) return;
+    float radius=hypotf(dx,dy),residual=radius-400.0f;
+    if (!isfinite(radius) || radius<300 || radius>500) return;
+    float correction=Clamp(-0.05f*residual,-1.5f,1.5f);
+    c->x_mm+=correction*dx/radius;c->y_mm+=correction*dy/radius;
+}
 static void Drive(CarControl *c,float speed,float omega,float dt,const CarInputs *in)
 {
     /* Differential drive forward only; curvature is limited before mixing. */
@@ -276,7 +296,9 @@ void CarControl_Update(CarControl *c,const CarInputs *in)
     float ds=(dl+dr)*0.5f, mid=c->heading_rad+turn*0.5f;
     c->x_mm+=ds*cosf(mid); c->y_mm+=ds*sinf(mid);
     c->heading_rad+=turn; c->distance_mm+=ds;
+    bool fresh_gray=in->gray_samples!=c->last_gray_samples;
     Gray(c,in);
+    ObserveArcLine(c,fresh_gray);
