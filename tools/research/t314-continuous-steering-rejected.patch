+#include "car_control.h"
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+
+static CarControl c;
+static CarInputs in;
+static void Init(void)
+{
+    CarGeometry g=CarGeometry_Default();g.confirmed=true;
+    CarControl_Init(&c,&g,0,false);c.task=4;c.target_laps=4;
+    c.state=CAR_ARC;c.segment=1;c.point_events=2;c.x_mm=1000;c.y_mm=-780;
+    c.segment_distance=-200;
+    in=(CarInputs){.enabled=true,.gray_online=true,.imu_ready=true,.encoder_valid=true,
+        .black_mask=0x18,.gray_position_valid=true,.gray_position_mm=3};
+}
+static void Step(bool fresh)
+{
+    in.now_ms+=15;
+    if(fresh) {++in.gray_samples;in.gray_position_samples=in.gray_samples;in.gray_position_at=in.now_ms;}
+    CarControl_Update(&c,&in);
+    assert(c.fault==CAR_OK);
+}
+int main(void)
+{
+    Init();Step(true);
+    assert(c.steering_analog && c.steering_error==3 && c.steering_rate==0);
+    assert(c.line_error==0 && c.black_frames==1 && c.point_events==2);
+    float turn=c.right_target-c.left_target;
+    in.gray_position_mm=5;Step(false);
+    assert(c.steering_error==3 && c.black_frames==1 && c.point_events==2);
+    Step(true);assert(c.steering_error==5 && c.steering_rate>0 && c.line_rate==0);
+    assert(c.right_target-c.left_target!=turn);
+    in.gray_position_valid=false;Step(true);
+    assert(!c.steering_analog && c.steering_error==c.line_error && c.steering_rate==c.line_rate);
+    in.gray_position_valid=true;Step(true);
+    assert(c.steering_analog && c.steering_rate==0); /* no source-change D kick */
+    in.gray_position_mm=NAN;Step(true);assert(!c.steering_analog);
+    in.gray_position_mm=30;Step(true);assert(!c.steering_analog); /* disagrees with binary */
+    in.gray_position_mm=3;
+    ++in.gray_samples;in.gray_position_samples=in.gray_samples-1;Step(false);
+    assert(!c.steering_analog);
+    ++in.gray_samples;in.gray_position_samples=in.gray_samples;in.gray_position_at=in.now_ms-100;
+    Step(false);assert(!c.steering_analog);
+    in.black_mask=0;Step(true);
+    assert(!c.steering_analog && c.line_missing && c.black_frames==0 && c.white_frames==1);
+    in.black_mask=0xff;Step(true);
+    assert(!c.steering_analog && c.white_frames==0 && c.point_events==2);
+    /* Gray counter and tick wrap still accept a matching fresh frame. */
+    Init();c.last_update=c.line_at=UINT32_MAX-9;c.last_gray_samples=UINT32_MAX;
+    in.now_ms=UINT32_MAX-9;in.gray_samples=UINT32_MAX;Step(true);
+    assert(c.steering_analog && c.black_frames==1);
+    Init();c.segment_distance=0;Step(true);
+    assert(!c.steering_analog && c.line_error==0 && c.point_events==2);
+    Init();in.black_mask=0x80;in.gray_position_mm=50;Step(true);
+    assert(!c.steering_analog && c.line_error==52.5f);
+    puts("PASS: analog steering, binary event authority, stale/mismatched/invalid fallback, derivative source changes and wrap");
+}
