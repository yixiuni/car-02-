+#!/usr/bin/env python3
+"""Compare binary fallback and hypothetical optical spots at T312 speeds.
+
+Raw optical response is a sensitivity assumption, not a measured sensor model.
+Every scenario checks actual plant coverage and existing endpoint/fault gates.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+ROOT=Path(__file__).resolve().parents[1]
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--output',type=Path,required=True)
+    p.add_argument('--compiler',default=shutil.which('clang') or shutil.which('gcc'))
+    a=p.parse_args()
+    if not a.compiler:p.error('Host C compiler required')
+    flags=['CAR_TASK1_TEST_BUILD','CAR_DUAL_MODE_BUILD','CAR_TIME_TRIAL_BUILD',
+        'CAR_TIME_TRIAL_STAGE2','CAR_TIME_TRIAL_C_ENTRY','CAR_TIME_TRIAL_FAST',
+        'CAR_TIME_TRIAL_ADAPTIVE','CAR_TIME_TRIAL_EXIT_TRACE','CAR_TIME_TRIAL_ARC_STEP',
+        'CAR_GRAY_POSITION_BUILD']
+    sources=['Core/Src/car_control.c','Core/Src/motion_control.c','Core/Src/imu_filter.c',
+        'Core/Src/gray_position.c','Core/Src/task1_test.c','Core/Src/course_mode.c','tests/sim_course.c']
+    (ROOT/'build-host').mkdir(exist_ok=True)
+    exe=ROOT/'build-host/gray-position-optical'
+    cmd=[a.compiler,'-std=c11','-O1','-Wall','-Wextra','-Werror',
+        '-fsanitize=address,undefined','-ICore/Inc',*['-D'+f+'=1' for f in flags],
+        *sources,'-lm','-o',str(exe)]
+    subprocess.run(cmd,cwd=ROOT,check=True)
+    clean={k:v for k,v in os.environ.items() if not k.startswith('SIM_')}
+    records=[]
+    for spot in [0,3,6,9]:
+        for phase in [0,2,5,7,10,12]:
+            for suite in ['full','d-offset','c-offset']:
+                env={**clean,'SIM_GRAY_POSITION_SPOT_MM':str(spot),
+                     'SIM_GRAY_PHASE_MS':str(phase),'SIM_WEAK_BRAKE':'1'}
+                if suite=='d-offset':env['SIM_D_ENTRY_SWEEP']='1'
+                if suite=='c-offset':env['SIM_C_ENTRY_SWEEP']='1'
+                run=subprocess.run([str(exe)],cwd=ROOT,env=env,text=True,capture_output=True)
+                records.append(dict(spot_mm=spot,phase_ms=phase,suite=suite,
+                    passed=run.returncode==0,stdout=run.stdout,stderr=run.stderr))
+        print('spot',spot,'passed',sum(r['passed'] for r in records if r['spot_mm']==spot),'/18',flush=True)
+    inputs=sources+['Core/Inc/car_config.h','Core/Inc/car_control.h','Core/Inc/gray_position.h',
+                    'tools/evaluate_gray_position.py']
+    report=dict(scope=__doc__,command=cmd,
+        inputs_sha256={s:hashlib.sha256((ROOT/s).read_bytes()).hexdigest() for s in inputs},runs=records,
+        all_passed=all(r['passed'] for r in records),physical_steering_validated=False)
+    a.output.parent.mkdir(parents=True,exist_ok=True)
+    a.output.write_text(json.dumps(report,indent=2)+'\n')
+    for r in records:
+        if not r['passed']:print(r['spot_mm'],r['phase_ms'],r['suite'],r['stderr'][:300])
+    print('Report only; inspect failures before any physical trial.')
+
+
+if __name__=='__main__':main()
