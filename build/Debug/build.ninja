  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\STM32project\stm32-car\build\Debug\cmake\stm32cubemx && "C:\Program Files\CMake\bin\cmake-gui.exe" -SD:\STM32project\stm32-car -BD:\STM32project\stm32-car\build\Debug"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build cmake/stm32cubemx/edit_cache: phony cmake/stm32cubemx/CMakeFiles/edit_cache.util


