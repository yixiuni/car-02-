# Utility command for rebuild_cache

build cmake/stm32cubemx/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\STM32project\stm32-car\build\Debug\cmake\stm32cubemx && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SD:\STM32project\stm32-car -BD:\STM32project\stm32-car\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

